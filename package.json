{
  "name": "uilayercraft",
  "version": "1.2.0",
  "description": "AI UI slicing for Figma: turn a flat UI image into slice assets, editable Figma layers or HTML/CSS.",
  "author": "Hieutapcode3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hieutapcode3/UILayerCraft.git"
  },
  "homepage": "https://github.com/Hieutapcode3/UILayerCraft#readme",
  "private": true,
  "scripts": {
    "api": "node src/server/index.js",
    "build": "npm run build:ui && npm run build:plugin-main && npm run build:figma-sim",
    "build:ui": "node scripts/build-ui-html.js",
    "build:plugin-main": "vite build --config scripts/vite.config.js --mode plugin-main",
    "build:figma-sim": "vite build --config scripts/vite.config.js --mode figma-sim",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1",
    "unit": "node --test tests/**/*.test.js",
    "test": "npm run unit && node --check src/server/index.js && node --check dist/code.js && node --check dist/figma-sim.js && node --check src/plugin/main.js && node --check scripts/vite.config.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@neplex/vectorizer": "^0.0.5",
    "fast-xml-parser": "^5.3.8",
    "makerjs": "^0.19.2",
    "openfig-core": "^0.4.1",
    "sharp": "^0.34.5",
    "svgpath": "^2.6.0",
    "zstd-codec": "^0.1.5"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "^8.1.5"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
